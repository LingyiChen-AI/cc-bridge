{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Bridge",
  "mainBinaryName": "cc-bridge",
  "version": "0.1.0",
  "identifier": "dev.freecall.ccbridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:27461",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CC Bridge",
        "width": 600,
        "height": 760,
        "minWidth": 520,
        "minHeight": 600,
        "resizable": true,
        "maximizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/nsis-header.bmp",
        "sidebarImage": "icons/installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "icons/installer/wix-banner.bmp",
        "dialogImagePath": "icons/installer/wix-dialog.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzQzUyOTMzQkJGNkFDQzUKUldURnJQYTdNeW5GODlZeEtSOFg2T0dPNFVXRGYwbi9RZTQrZ3VrZks1bHdPUDBnRjFOMU5mVzUK",
      "endpoints": [
        "https://github.com/LingyiChen-AI/cc-bridge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
